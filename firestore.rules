// =============================================================
// DRG-Rently — Regras Firestore
// Cole este conteúdo no Firebase Console → Firestore → Rules → Publish
// Última atualização: 2026-10-28 (leitura de leads e Livro Caixa por módulo; exceção de contato
//                     do proprietário por corretor; distribuição de leads e carteira — 179 testes)
// =============================================================
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }

    function userExists() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isSuperAdmin() {
      return isSignedIn() && userExists() && userDoc().role == 'super_admin';
    }

    function isDRGTeam() {
      // Equipe DRG (super_admin ou operador_drg) — vê o painel Super Admin
      return isSignedIn() && userExists()
             && (userDoc().role == 'super_admin' || userDoc().role == 'operador_drg');
    }

    function belongsToTenant(tenantId) {
      return isSignedIn() && userExists() && userDoc().tenantId == tenantId;
    }

    function isAdminOf(tenantId) {
      return belongsToTenant(tenantId) && userDoc().role == 'admin';
    }

    // Corretor ATIVO do tenant (pendente/suspenso = ativo:false → sem acesso)
    function isCorretorOf(tenantId) {
      return belongsToTenant(tenantId) && userDoc().role == 'corretor'
             && userDoc().get('ativo', true) == true;
    }

    // Equipe interna do tenant (admin/operador) — acesso total às subcoleções
    function isEquipeTenant(tenantId) {
      return belongsToTenant(tenantId) && userDoc().role != 'corretor';
    }

    // Programa "Seja corretor parceiro" ligado no tenant (tenants/{id}.programaParceiros.ativo)
    function programaParceirosAtivo(tenantId) {
      return get(/databases/$(database)/documents/tenants/$(tenantId)).data
               .get('programaParceiros', {}).get('ativo', false) == true;
    }

    // Perfis 3.0 — quem tem "👥 Gerenciar usuários e perfis" (✅ Pode) no perfil
    // atribuído. Admin continua coberto pelas regras de role 'admin'.
    // Mesmo critério do app: perfil atribuído (perfilId) ou, sem ele, o perfil-base do tipo (seed_<role>).
    function perfilConcedeGerenciar(tenantId, perfilDocId) {
      return exists(/databases/$(database)/documents/tenants/$(tenantId)/perfis/$(perfilDocId))
             && get(/databases/$(database)/documents/tenants/$(tenantId)/perfis/$(perfilDocId)).data
                  .get('acoes', {}).get('gerenciarUsuariosPerfis', false) == 'sim';
    }
    function delegadoGerenciar(tenantId) {
      return belongsToTenant(tenantId)
             && userDoc().get('ativo', true) == true
             && ((userDoc().get('perfilId', null) is string
                  && perfilConcedeGerenciar(tenantId, userDoc().perfilId))
                 || (!(userDoc().get('perfilId', null) is string)
                     && perfilConcedeGerenciar(tenantId, 'seed_' + userDoc().role)));
    }

    // ---------- Perfis 3.0 no servidor (fase 4) ----------
    // Mesmo critério do app (normalizarPerfil em app.js): perfil atribuído
    // (perfilId) → perfil-base do tipo (seed_<role>) → sem perfil nenhum = padrão
    // do código, que continua liberado como sempre foi. Admin tem piso: sempre pode.
    // Só "✅ Pode" grava direto; "🕓 Com aprovação" passa pela fila alteracoesPendentes.
    function perfilIdEfetivo() {
      return userDoc().get('perfilId', null) is string ? userDoc().perfilId : 'seed_' + userDoc().role;
    }
    // Formatos aceitos: 3.0 {ver, criar/editar/excluir: 'sim'|'aprovacao'|'nao'},
    // 2.0 {ver|acesso, editar: true} e lista {modulos: [...]}
    function nivelDoPerfil(p, modulo, op) {
      let perms = p.get('permissoes', null);
      let m = perms is map ? perms.get(modulo, {}) : {};
      let ver = m.get('ver', m.get('acesso', false)) == true;
      return perms is map
        ? (!ver ? 'nao' : (m.get(op, null) is string ? m.get(op, 'nao') : (m.get('editar', false) == true ? 'sim' : 'nao')))
        : (p.get('modulos', null) is list ? (modulo in p.modulos ? 'sim' : 'nao') : 'sim');
    }
    function veNoPerfil(p, modulo) {
      let perms = p.get('permissoes', null);
      let m = perms is map ? perms.get(modulo, {}) : {};
      return perms is map ? m.get('ver', m.get('acesso', false)) == true
           : (p.get('modulos', null) is list ? modulo in p.modulos : true);
    }
    function caminhoPerfil(tenantId) {
      return /databases/$(database)/documents/tenants/$(tenantId)/perfis/$(perfilIdEfetivo());
    }
    function podeNoModulo(tenantId, modulo, op) {
      return userDoc().role == 'admin'
             || !exists(caminhoPerfil(tenantId))
             || nivelDoPerfil(get(caminhoPerfil(tenantId)).data, modulo, op) == 'sim';
    }
    function veModulo(tenantId, modulo) {
      return userDoc().role == 'admin'
             || !exists(caminhoPerfil(tenantId))
             || veNoPerfil(get(caminhoPerfil(tenantId)).data, modulo);
    }
    // Coleção → módulo (espelho de MODULO_COLECAO no app.js). Fora da lista = sem trava
    // (fila, auditoria, vitrine, fichas, contadores, config, estatísticas…)
    function colecaoProtegida(colecao) {
      return colecao in ['locadores', 'locatarios', 'garantias', 'compradores', 'negociacoes',
                         'imoveis', 'contratos', 'balancetes', 'leadsImoveis', 'caixaPool'];
    }
    function moduloDaColecao(colecao) {
      return colecao == 'leadsImoveis' ? 'leads' : (colecao == 'caixaPool' ? 'caixa' : colecao);
    }
    function podeGravar(tenantId, colecao, op) {
      return !colecaoProtegida(colecao) || podeNoModulo(tenantId, moduloDaColecao(colecao), op);
    }
    function soCampos(lista) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(lista);
    }
    // Efeitos colaterais que as telas fazem fora do próprio módulo (não podem quebrar):
    //  - contrato/venda/distrato mudam SÓ o status do imóvel (alugado/vendido/disponível);
    //  - ZapSign atualiza a assinatura (e o status quando assinado) de contrato/negociação;
    //  - enviar balancete por e-mail grava o envio.
    function efeitoColateralPermitido(tenantId, colecao) {
      return (colecao == 'imoveis' && soCampos(['status'])
              && (podeNoModulo(tenantId, 'contratos', 'criar') || podeNoModulo(tenantId, 'contratos', 'editar')
                  || podeNoModulo(tenantId, 'contratos', 'excluir') || podeNoModulo(tenantId, 'negociacoes', 'criar')
                  || podeNoModulo(tenantId, 'negociacoes', 'editar')))
          || ((colecao == 'contratos' || colecao == 'negociacoes') && veModulo(tenantId, colecao)
              && (soCampos(['zapsign'])
                  || (soCampos(['status']) && resource.data.get('zapsign', {}).get('status', '') == 'signed')))
          || (colecao == 'balancetes' && veModulo(tenantId, 'balancetes')
              && soCampos(['status', 'emailEnviadoEm', 'emailEnviadoPara', 'emailEnviadoBcc',
                           'emailLocatarioEnviadoEm', 'emailLocatarioEnviadoPara', 'emailLocatarioEnviadoBcc']));
    }
    // Meu site (construtor de sites, 17/10/2026): editar o rascunho e publicar são permissões
    // que o gestor da imobiliária delega em "Equipe e permissões" — sem perfil, só o gestor.
    function podeEditarSite(tenantId) {
      return isAdminOf(tenantId) || isDRGTeam()
             || (isEquipeTenant(tenantId) && exists(caminhoPerfil(tenantId))
                 && nivelDoPerfil(get(caminhoPerfil(tenantId)).data, 'site', 'editar') == 'sim');
    }
    function podePublicarSite(tenantId) {
      return isAdminOf(tenantId) || isDRGTeam()
             || (isEquipeTenant(tenantId) && exists(caminhoPerfil(tenantId))
                 && get(caminhoPerfil(tenantId)).data.get('acoes', {}).get('publicarSite', 'nao') in ['sim', true]);
    }
    // Coleções com regra própria: a regra genérica da equipe não grava nelas
    function colecaoComRegraPropria(colecao) {
      return colecao in ['auditoria', 'site', 'siteVersoes', 'leadsCorretor', 'registrosCliente', 'registrosClienteChave'];
    }
    // Registro de auditoria honesto: em nome de quem grava e com a hora do servidor
    function registroDeAuditoriaValido() {
      return request.resource.data.userId == request.auth.uid
             && request.resource.data.timestamp == request.time;
    }
    // 🔒 BLINDAGEM DE CONTATO (17/10/2026, ordem do dono): o contato é SEMPRE o da imobiliária.
    // Texto que o CORRETOR grava e que vai a público (site, portais, ficha da rede) não pode ter
    // telefone, e-mail, link, @perfil nem menção a WhatsApp/redes. Espelho: RE_CONTATO no rede.js.
    function semContato(v) {
      return !(v is string)
             || !v.lower().matches('(?s).*(https?:|www[.]|wa[.]me|bit[.]ly|linktr|[a-z0-9][.](com|net|org|me|ly|io|app|site|link|br)([^a-z0-9]|$)|@[a-z0-9_]|[0-9]([ .()-]*[0-9]){7,}|whats|wpp|telegram|instagram|facebook|tik ?tok|gmail|hotmail|outlook|arroba|me chama|chama no|ligue|ligar para|meu (cel|tel|n[uú]mero|contato|zap)|((zero|um|uma|dois|duas|tr[eê]s|quatro|cinco|seis|sete|oito|nove)[ ,.-]+){5,}).*');
    }
    function listaSemContato(v) {
      return !(v is list) || v.size() == 0 || semContato(v.join(' '));
    }
    // Vídeo e tour: só destes serviços (nada de perfil, site pessoal ou wa.me)
    function urlMidiaOk(v) {
      return v == null || (v is string && v.lower().matches('https://(www[.]|m[.]|player[.]|my[.])?(youtube[.]com|youtu[.]be|vimeo[.]com|matterport[.]com|kuula[.]co|momento360[.]com)/.*'));
    }
    function enderecoSemContato(e) {
      return !(e is map)
             || (semContato(e.get('logradouro', null)) && semContato(e.get('bairro', null))
                 && semContato(e.get('cidade', null)) && semContato(e.get('complemento', null)));
    }
    function textosPublicosLimpos(d) {
      return semContato(d.get('apelido', null)) && semContato(d.get('tituloAnuncio', null))
             && semContato(d.get('descricaoLonga', null)) && semContato(d.get('permutaObs', null))
             && semContato(d.get('imediacoesTexto', null))
             && listaSemContato(d.get('tags', null)) && enderecoSemContato(d.get('endereco', null))
             && urlMidiaOk(d.get('videoUrl', null)) && urlMidiaOk(d.get('tourUrl', null));
    }
    // Ficha da rede gravada pelo corretor: sem contato de captador/proprietário e sem texto com contato
    function fichaSemContato(d) {
      return d.get('captador', null) == null && d.get('proprietario', null) == null
             && d.get('captadorNome', null) == null
             && textosPublicosLimpos(d) && semContato(d.get('obs', null));
    }

    // Excluir contrato apaga a garantia dele junto
    function exclusaoEmCascata(tenantId, colecao) {
      return colecao == 'garantias' && podeNoModulo(tenantId, 'contratos', 'excluir');
    }

    // Campos que o próprio usuário NUNCA pode alterar no seu doc
    function camposProtegidosIntactos() {
      return !request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(['role', 'tenantId', 'ativo', 'perfilId', 'drgPerfilId', 'status']);
    }

    // ----------- USERS -----------
    match /users/{uid} {
      // Leituras
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow read: if isDRGTeam();
      allow read: if isSignedIn() && userExists()
                  && userDoc().role == 'admin'
                  && resource.data.tenantId == userDoc().tenantId;
      // Perfis 3.0: delegado lista a equipe do próprio tenant
      allow read: if isSignedIn() && userExists()
                  && resource.data.tenantId == userDoc().tenantId
                  && delegadoGerenciar(userDoc().tenantId);

      // Criações
      // (a) signup de imobiliária: vira admin SÓ do tenant que ele mesmo criou no mesmo batch
      allow create: if isSignedIn() && request.auth.uid == uid
                    && request.resource.data.role == 'admin'
                    && getAfter(/databases/$(database)/documents/tenants/$(request.resource.data.tenantId)).data.criadoPor == request.auth.uid;
      // (b) autocadastro de corretor parceiro: nasce pendente e desativado,
      //     e só se o tenant estiver com o programa de parceiros ligado
      allow create: if isSignedIn() && request.auth.uid == uid
                    && request.resource.data.role == 'corretor'
                    && request.resource.data.ativo == false
                    && request.resource.data.status == 'pendente'
                    && programaParceirosAtivo(request.resource.data.tenantId);
      // (c) admin criando usuário do próprio tenant (nunca equipe DRG)
      allow create: if isSignedIn() && userExists()
                    && userDoc().role == 'admin'
                    && request.resource.data.tenantId == userDoc().tenantId
                    && request.resource.data.role in ['admin', 'operador', 'corretor'];
      // (c2) Perfis 3.0: delegado cria operador/corretor do próprio tenant (nunca admin)
      allow create: if isSignedIn() && userExists()
                    && request.resource.data.tenantId == userDoc().tenantId
                    && request.resource.data.role in ['operador', 'corretor']
                    && delegadoGerenciar(userDoc().tenantId);
      // (d) super_admin criando equipe DRG
      allow create: if isSuperAdmin()
                    && (!('tenantId' in request.resource.data)
                        || request.resource.data.tenantId == null);
      // (e) equipe DRG atuando num tenant: cria admin/operador/corretor dele (nunca equipe DRG)
      allow create: if isDRGTeam()
                    && request.resource.data.tenantId is string
                    && request.resource.data.role in ['admin', 'operador', 'corretor'];

      // Atualizações
      allow update: if isSignedIn() && request.auth.uid == uid && camposProtegidosIntactos();
      allow update: if isSuperAdmin();
      // equipe DRG atuando num tenant: aprova/suspende/edita usuários dele
      allow update: if isDRGTeam()
                    && resource.data.get('tenantId', null) is string
                    && request.resource.data.tenantId == resource.data.tenantId
                    && request.resource.data.role in ['admin', 'operador', 'corretor'];
      allow update: if isSignedIn() && userExists()
                    && userDoc().role == 'admin'
                    && resource.data.tenantId == userDoc().tenantId
                    && request.resource.data.tenantId == userDoc().tenantId
                    && request.resource.data.role in ['admin', 'operador', 'corretor'];

      // Perfis 3.0: delegado troca perfil / ativa-desativa operador e corretor do
      // próprio tenant — nunca a si mesmo, nunca admin, nunca outro campo
      allow update: if isSignedIn() && userExists()
                    && request.auth.uid != uid
                    && resource.data.tenantId == userDoc().tenantId
                    && resource.data.role in ['operador', 'corretor']
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['perfilId', 'ativo'])
                    && delegadoGerenciar(userDoc().tenantId);

      // Deleções
      allow delete: if isSuperAdmin();
    }

    // ----------- DRG PERFIS (perfis customizáveis da equipe interna) -----------
    match /drgPerfis/{perfilId} {
      allow read: if isDRGTeam();
      allow create, update, delete: if isSuperAdmin();
    }

    // ----------- DRG CONFIG (configurações globais da DRG: Asaas, etc.) -----------
    // Apenas super_admin lê/escreve. Não é DRGTeam (operador_drg não vê tokens).
    match /drgConfig/{docId} {
      allow read, write: if isSuperAdmin();
    }

    // ----------- TENANTS -----------
    match /tenants/{tenantId} {
      allow read;  // leitura pública dos campos públicos (nome, telefone, emailContato)
      allow create: if isSignedIn() && request.resource.data.criadoPor == request.auth.uid;
      allow update: if isAdminOf(tenantId);
      allow update: if isSuperAdmin();
      allow delete: if isSuperAdmin();

      // Subcoleções genéricas — só equipe interna (corretor NÃO entra aqui).
      // Gravação conferida pelo perfil (fase 4); leitura continua livre para a equipe.
      // Auditoria (17/10/2026): IMUTÁVEL — ninguém altera nem apaga, e cada um só registra em
      // nome próprio, com a hora do servidor. Lê quem enxerga o módulo Auditoria.
      // 🔒 Leitura por módulo (28/10/2026): leads (contato do cliente) e Livro Caixa só para quem
      // VÊ o módulo no perfil — antes o "Ver" só escondia a tela. Demais cadastros seguem livres
      // para a equipe (uma tela lê dados de outras: contrato lê proprietário, imóvel etc.).
      match /{collection}/{docId} {
        allow read: if isEquipeTenant(tenantId)
                    && (collection != 'auditoria' || veModulo(tenantId, 'auditoria'))
                    && (!(collection in ['leadsImoveis', 'leadsCorretor']) || veModulo(tenantId, 'leads'))
                    && (!(collection in ['caixaPool', 'caixaPoolFechamento']) || veModulo(tenantId, 'caixa'));
        allow create: if isEquipeTenant(tenantId) && podeGravar(tenantId, collection, 'criar')
                      && (collection != 'auditoria' || registroDeAuditoriaValido())
                      && !(collection in ['site', 'siteVersoes', 'leadsCorretor', 'registrosCliente', 'registrosClienteChave']);
        allow update: if isEquipeTenant(tenantId) && !colecaoComRegraPropria(collection)
                      && (podeGravar(tenantId, collection, 'editar') || efeitoColateralPermitido(tenantId, collection));
        allow delete: if isEquipeTenant(tenantId) && !colecaoComRegraPropria(collection)
                      && (podeGravar(tenantId, collection, 'excluir') || exclusaoEmCascata(tenantId, collection));
        allow read: if isDRGTeam();
        allow create: if isDRGTeam() && (collection != 'auditoria' || registroDeAuditoriaValido())
                      && !(collection in ['site', 'siteVersoes', 'leadsCorretor', 'registrosCliente', 'registrosClienteChave']);
        allow update, delete: if isDRGTeam() && !colecaoComRegraPropria(collection);
      }

      // Meu site: rascunho (quem edita) e publicado (quem publica; o site público lê).
      match /site/{docId} {
        allow read: if docId == 'publicado';
        allow read: if isEquipeTenant(tenantId) || isDRGTeam();
        allow write: if docId == 'rascunho' && podeEditarSite(tenantId);
        allow write: if docId == 'publicado' && podePublicarSite(tenantId);
      }
      // Histórico de publicações: quem publica acrescenta; ninguém altera nem apaga
      match /siteVersoes/{versaoId} {
        allow read: if isEquipeTenant(tenantId) || isDRGTeam();
        allow create: if podePublicarSite(tenantId);
        allow update, delete: if false;
      }

      // Perfis 3.0 — fila "Com aprovação": corretor cria pedido em nome próprio
      // e acompanha só os seus. Decidir (aprovar/rejeitar) é da equipe interna.
      match /alteracoesPendentes/{pedidoId} {
        // Só imóveis/proprietários, módulo = coleção, e editar/excluir só do que ELE captou
        allow create: if isCorretorOf(tenantId)
                      && request.resource.data.solicitadoPor == request.auth.uid
                      && request.resource.data.status == 'PENDENTE'
                      && request.resource.data.colecao in ['imoveis', 'locadores']
                      && request.resource.data.modulo == request.resource.data.colecao
                      && request.resource.data.op in ['criar', 'editar', 'excluir']
                      && (request.resource.data.op == 'criar'
                          || get(/databases/$(database)/documents/tenants/$(tenantId)/$(request.resource.data.colecao)/$(request.resource.data.docId)).data.criadoPor == request.auth.uid)
                      // 🔒 blindagem: o pedido também não leva contato em texto público nem muda o compartilhamento
                      && (request.resource.data.colecao != 'imoveis' || request.resource.data.get('dados', null) == null
                          || (textosPublicosLimpos(request.resource.data.dados)
                              && request.resource.data.dados.get('compartilhadoCom', null) == null));
        allow read: if isCorretorOf(tenantId)
                    && resource.data.solicitadoPor == request.auth.uid;
      }

      // Perfis: corretor lê (precisa resolver o próprio perfil no login)
      match /perfis/{perfilId} {
        allow read: if isCorretorOf(tenantId);
      }

      // Config da rede (campos visíveis etc.): corretor só lê.
      // Demais docs de config (tokens, workers) seguem só pra equipe.
      match /config/rede {
        allow read: if isCorretorOf(tenantId);
      }

      // Contador do código do anúncio (anuncios.js): o corretor que cadastra
      // imóvel reserva o próximo número. Só +1 por vez, sem mexer no prefixo.
      // (equipe interna já grava pela regra genérica de subcoleção)
      match /contadores/anuncios {
        allow read: if isCorretorOf(tenantId);
        allow create: if isCorretorOf(tenantId)
                      && request.resource.data.seq == 1
                      && request.resource.data.keys().hasOnly(['seq', 'prefixo']);
        allow update: if isCorretorOf(tenantId)
                      && request.resource.data.seq == resource.data.seq + 1
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seq']);
      }

      // Diretório de corretores do tenant
      // 🔒 Blindagem (17/10/2026): corretor lê SÓ o próprio cartão — nome, telefone e e-mail
      // de colega não circulam; quem liga corretor a corretor é a imobiliária.
      match /corretores/{corretorId} {
        allow read: if isCorretorOf(tenantId) && request.auth.uid == corretorId;
        // corretor edita o próprio cartão, sem mexer em status/tipo/comissão
        allow update: if isCorretorOf(tenantId) && request.auth.uid == corretorId
                      && !request.resource.data.diff(resource.data).affectedKeys()
                          .hasAny(['status', 'tipo', 'comissao', 'tenantId', 'uid', 'creciConferido', 'contratoParceria', 'verContatoProprietario']);
        // autocadastro: cria o próprio cartão pendente (programa ligado)
        allow create: if isSignedIn() && request.auth.uid == corretorId
                      && !request.resource.data.keys().hasAny(['creciConferido', 'contratoParceria', 'verContatoProprietario'])
                      && request.resource.data.status == 'pendente'
                      && request.resource.data.tipo == 'parceiro'
                      && programaParceirosAtivo(tenantId);
      }

      // 🛡 "Tenho um cliente" (protecao.js, 17/10/2026): protocolo do corretor com data e hora do
      // servidor. Ninguém altera o que foi registrado nem apaga; a equipe só anota a análise.
      match /registrosCliente/{regId} {
        allow read: if isCorretorOf(tenantId) && resource.data.corretorUid == request.auth.uid;
        allow create: if isCorretorOf(tenantId)
                      && request.resource.data.corretorUid == request.auth.uid
                      && request.resource.data.criadoEm == request.time
                      && request.resource.data.keys().hasOnly(['corretorUid', 'corretorNome', 'clienteNome', 'telefone', 'email',
                           'procura', 'codigoAnuncio', 'obs', 'chave', 'criadoEm'])
                      && request.resource.data.clienteNome is string && request.resource.data.clienteNome.size() <= 120
                      && request.resource.data.telefone is string && request.resource.data.telefone.matches('[0-9]{10,11}')
                      && request.resource.data.chave is string
                      && existsAfter(/databases/$(database)/documents/tenants/$(tenantId)/registrosClienteChave/$(request.resource.data.chave));
        allow read: if isEquipeTenant(tenantId) || isDRGTeam();
        allow update: if (isEquipeTenant(tenantId) || isDRGTeam())
                      && soCampos(['analise', 'analiseNota', 'analisadoPor', 'analisadoEm']);
        allow delete: if false;
      }
      // Um cliente (celular, em SHA-256) = um registro: o segundo corretor é recusado
      match /registrosClienteChave/{chave} {
        allow create: if isCorretorOf(tenantId)
                      && request.resource.data.corretorUid == request.auth.uid
                      && request.resource.data.criadoEm == request.time
                      && request.resource.data.keys().hasOnly(['corretorUid', 'registroId', 'criadoEm'])
                      && getAfter(/databases/$(database)/documents/tenants/$(tenantId)/registrosCliente/$(request.resource.data.registroId)).data.chave == chave;
        allow read: if isEquipeTenant(tenantId) || isDRGTeam();
        allow update, delete: if false;
      }

      // Extrato de comissão: corretor lê só os negócios em que participa
      match /comissoes/{negId} {
        allow read: if isCorretorOf(tenantId)
                    && request.auth.uid in resource.data.participantes;
      }

      // Vitrine pública: cópia enxuta do imóvel publicado (site + feed dos portais)
      match /vitrine/{imovelId} {
        allow read;
        // corretor só atualiza a cópia de imóvel DELE que a imobiliária já publicou
        allow create, update: if isCorretorOf(tenantId)
                              && get(/databases/$(database)/documents/tenants/$(tenantId)/imoveis/$(imovelId)).data.criadoPor == request.auth.uid
                              && get(/databases/$(database)/documents/tenants/$(tenantId)/imoveis/$(imovelId)).data.get('linkPublico', false) == true
                              && textosPublicosLimpos(request.resource.data);
        allow delete: if isCorretorOf(tenantId)
                      && get(/databases/$(database)/documents/tenants/$(tenantId)/imoveis/$(imovelId)).data.criadoPor == request.auth.uid;
      }

      // "Anuncie seu imóvel" da vitrine pública: qualquer visitante cria, só cria
      match /leadsImoveis/{leadId} {
        allow create: if request.resource.data.origem == 'vitrine_publica'
                      && request.resource.data.status == 'novo'
                      && request.resource.data.keys().hasOnly(['origem', 'nome', 'telefone', 'email',
                           'finalidade', 'tipo', 'cidadeBairro', 'descricao', 'status',
                           'criadoEm', 'userAgent', 'url'])
                      && request.resource.data.nome is string
                      && request.resource.data.nome.size() <= 200
                      && (request.resource.data.get('descricao', null) == null
                          || request.resource.data.descricao.size() <= 5000);
      }

      // "Agendar visita / Tenho interesse" da página do imóvel: visitante só cria,
      // com campos fechados, para imóvel que está publicado na vitrine
      match /leadsImoveis/{leadId} {
        allow create: if request.resource.data.origem == 'interesse_imovel'
                      && request.resource.data.status == 'novo'
                      && request.resource.data.keys().hasOnly(['origem', 'nome', 'telefone', 'email',
                           'imovelId', 'codigoAnuncio', 'tituloImovel', 'finalidade', 'melhorHorario',
                           'mensagem', 'status', 'criadoEm', 'url', 'userAgent'])
                      && request.resource.data.nome is string
                      && request.resource.data.nome.size() >= 2 && request.resource.data.nome.size() <= 200
                      && request.resource.data.telefone is string
                      && request.resource.data.telefone.matches('[0-9]{10,13}')
                      && request.resource.data.imovelId is string
                      && exists(/databases/$(database)/documents/tenants/$(tenantId)/vitrine/$(request.resource.data.imovelId))
                      && request.resource.data.criadoEm == request.time
                      && (request.resource.data.get('mensagem', null) == null
                          || request.resource.data.mensagem.size() <= 1000);
      }

      // Leads repassados ao corretor ("Meus leads").
      // 🔒 Blindagem (17/10/2026): o corretor NÃO lê mais o lead original (tem telefone e
      // e-mail do cliente). Lê só a CÓPIA leadsCorretor/{id} — primeiro nome, imóvel e
      // mensagem sem contato — que a equipe grava ao repassar, e só mexe no atendimento
      // (status, anotação, histórico). Não troca de corretor — só DEVOLVE.
      // (antes: allow read/update em leadsImoveis quando corretorUid == ele)
      match /leadsCorretor/{leadId} {
        // equipe: repassar é EDITAR o lead — quem edita leads grava/apaga a cópia
        allow create, update, delete: if (isEquipeTenant(tenantId) && podeNoModulo(tenantId, 'leads', 'editar')) || isDRGTeam();
        allow read: if isCorretorOf(tenantId)
                    && resource.data.get('corretorUid', null) == request.auth.uid;
        allow update: if isCorretorOf(tenantId)
                      && resource.data.get('corretorUid', null) == request.auth.uid
                      && soCampos(['status', 'statusAtualizadoEm', 'statusAtualizadoPor', 'notaCorretor',
                                   'historico', 'corretorUid', 'motivoDevolucao',
                                   'devolvidoEm', 'devolvidoPor'])
                      && request.resource.data.historico is list
                      && request.resource.data.historico.size() <= 40
                      && ((request.resource.data.get('corretorUid', null) == request.auth.uid
                           && request.resource.data.status in ['novo', 'contatado', 'convertido', 'descartado'])
                          || (request.resource.data.get('corretorUid', null) == null
                              && request.resource.data.status == 'devolvido'
                              && request.resource.data.motivoDevolucao is string
                              && request.resource.data.motivoDevolucao.size() > 0
                              && request.resource.data.motivoDevolucao.size() <= 500));
      }

      // Estatísticas dos imóveis publicados (relatório ao proprietário).
      // Visitante só soma 1 por vez num contador; nunca lê, zera ou apaga.
      match /estatisticas/{estId} {
        function contadorOk(d, k) { return d.get(k, 0) is int && d.get(k, 0) >= 0 && d.get(k, 0) <= 1; }
        allow create: if request.resource.data.keys().hasOnly(['imovelId', 'mes', 'visitas', 'favoritos', 'contatos', 'compartilhamentos'])
                      && request.resource.data.imovelId is string
                      && request.resource.data.mes is string
                      && request.resource.data.mes.matches('[0-9]{4}-[0-9]{2}')
                      && estId == request.resource.data.imovelId + '_' + request.resource.data.mes
                      && exists(/databases/$(database)/documents/tenants/$(tenantId)/vitrine/$(request.resource.data.imovelId))
                      && contadorOk(request.resource.data, 'visitas') && contadorOk(request.resource.data, 'favoritos')
                      && contadorOk(request.resource.data, 'contatos') && contadorOk(request.resource.data, 'compartilhamentos');
        // exatamente um contador muda, e só +1
        function maisUm(k) {
          return request.resource.data.diff(resource.data).affectedKeys().hasOnly([k])
                 && request.resource.data.get(k, 0) == resource.data.get(k, 0) + 1;
        }
        allow update: if maisUm('visitas') || maisUm('favoritos') || maisUm('contatos') || maisUm('compartilhamentos');
      }

      // Auditoria: o corretor também deixa rastro (só cria, em nome próprio; nunca lê/altera/apaga).
      // Antes ele ficava fora da regra genérica e as ações dele não eram registradas.
      match /auditoria/{logId} {
        allow create: if isCorretorOf(tenantId)
                      && request.resource.data.userId == request.auth.uid
                      && request.resource.data.userRole == 'corretor'
                      && request.resource.data.timestamp == request.time;
      }

      // Endereço do Worker da IA (sem segredo): o corretor precisa para o gerador de anúncios
      match /config/ia {
        allow read: if isCorretorOf(tenantId);
      }

      // Locadores (proprietários): corretor só os que ele cadastrou
      match /locadores/{locId} {
        allow read, update, delete: if isCorretorOf(tenantId)
                                    && resource.data.criadoPor == request.auth.uid;
        allow create: if isCorretorOf(tenantId)
                      && request.resource.data.criadoPor == request.auth.uid;
      }

      // Imóveis
      match /imoveis/{imovelId} {
        // (sem leitura pública: site e feed leem a coleção "vitrine")
        // Gravação da equipe: regra genérica acima (conferida pelo perfil)
        allow read: if isEquipeTenant(tenantId);
        allow read, write: if isDRGTeam();
        // Corretor: só os que ele captou
        allow read, delete: if isCorretorOf(tenantId)
                            && resource.data.criadoPor == request.auth.uid;
        // (publicar no site/portais — linkPublico — é decisão da imobiliária)
        // 🔒 textos públicos sem contato; com quem a ficha completa é compartilhada é a imobiliária que decide
        allow create: if isCorretorOf(tenantId)
                      && request.resource.data.criadoPor == request.auth.uid
                      && request.resource.data.get('linkPublico', false) == false
                      && request.resource.data.get('compartilhadoCom', []).size() == 0
                      && textosPublicosLimpos(request.resource.data);
        allow update: if isCorretorOf(tenantId)
                      && resource.data.criadoPor == request.auth.uid
                      && request.resource.data.criadoPor == request.auth.uid
                      && request.resource.data.get('linkPublico', false) == resource.data.get('linkPublico', false)
                      && request.resource.data.get('compartilhadoCom', []) == resource.data.get('compartilhadoCom', [])
                      && textosPublicosLimpos(request.resource.data);

        // Fotos do imóvel: leitura sempre pública (galeria)
        match /fotos/{fotoId} {
          allow read;
          allow write: if isEquipeTenant(tenantId);
          allow write: if isDRGTeam();
          // corretor: só no imóvel dele, e a URL tem que ser do nosso Storage
          allow delete: if isCorretorOf(tenantId)
                        && get(/databases/$(database)/documents/tenants/$(tenantId)/imoveis/$(imovelId)).data.criadoPor == request.auth.uid;
          allow create, update: if isCorretorOf(tenantId)
                        && get(/databases/$(database)/documents/tenants/$(tenantId)/imoveis/$(imovelId)).data.criadoPor == request.auth.uid
                        && request.resource.data.get('url', '').matches('https://firebasestorage[.]googleapis[.]com/.*')
                        && semContato(request.resource.data.get('nome', null))
                        && semContato(request.resource.data.get('legenda', null));
        }
      }

      // Ficha da rede: cópia do imóvel só com os campos liberados em config/rede.
      // Corretor vê se: visível pra rede, OU é o captador, OU foi liberado pra ele.
      match /imoveisRede/{imovelId} {
        allow read: if isCorretorOf(tenantId)
                    && (resource.data.visivel == true
                        || resource.data.captadorUid == request.auth.uid
                        || request.auth.uid in resource.data.get('compartilhadoCom', []));
        allow create: if isCorretorOf(tenantId)
                      && request.resource.data.captadorUid == request.auth.uid
                      && get(/databases/$(database)/documents/tenants/$(tenantId)/imoveis/$(imovelId)).data.criadoPor == request.auth.uid
                      && request.resource.data.get('compartilhadoCom', []) == get(/databases/$(database)/documents/tenants/$(tenantId)/imoveis/$(imovelId)).data.get('compartilhadoCom', [])
                      && fichaSemContato(request.resource.data);
        allow update: if isCorretorOf(tenantId)
                      && resource.data.captadorUid == request.auth.uid
                      && request.resource.data.captadorUid == request.auth.uid
                      && request.resource.data.get('compartilhadoCom', []) == get(/databases/$(database)/documents/tenants/$(tenantId)/imoveis/$(imovelId)).data.get('compartilhadoCom', [])
                      && fichaSemContato(request.resource.data);
        allow delete: if isCorretorOf(tenantId)
                      && resource.data.captadorUid == request.auth.uid;

        // 🔓 Contato do proprietário (exceção, 28/10/2026): só a equipe grava; lê só o corretor
        // marcado pela imobiliária (corretores/{uid}.verContatoProprietario) e só de ficha que ele enxerga.
        match /contato/{docId} {
          allow read, write: if isEquipeTenant(tenantId);
          allow read, write: if isDRGTeam();
          allow read: if isCorretorOf(tenantId)
                      && get(/databases/$(database)/documents/tenants/$(tenantId)/corretores/$(request.auth.uid)).data.get('verContatoProprietario', false) == true
                      && (get(/databases/$(database)/documents/tenants/$(tenantId)/imoveisRede/$(imovelId)).data.get('visivel', false) == true
                          || get(/databases/$(database)/documents/tenants/$(tenantId)/imoveisRede/$(imovelId)).data.captadorUid == request.auth.uid
                          || request.auth.uid in get(/databases/$(database)/documents/tenants/$(tenantId)/imoveisRede/$(imovelId)).data.get('compartilhadoCom', []));
        }

        // Ficha COMPLETA: só captador e corretores liberados
        match /completo/{docId} {
          allow read, write: if isEquipeTenant(tenantId);
          allow read, write: if isDRGTeam();
          allow read: if isCorretorOf(tenantId)
                      && (get(/databases/$(database)/documents/tenants/$(tenantId)/imoveisRede/$(imovelId)).data.captadorUid == request.auth.uid
                          || request.auth.uid in get(/databases/$(database)/documents/tenants/$(tenantId)/imoveisRede/$(imovelId)).data.get('compartilhadoCom', []));
          allow delete: if isCorretorOf(tenantId)
                        && get(/databases/$(database)/documents/tenants/$(tenantId)/imoveis/$(imovelId)).data.criadoPor == request.auth.uid;
          allow create, update: if isCorretorOf(tenantId)
                       && get(/databases/$(database)/documents/tenants/$(tenantId)/imoveis/$(imovelId)).data.criadoPor == request.auth.uid
                       && fichaSemContato(request.resource.data);
        }
      }
    }

    // ----------- LOGS DE AUDITORIA (collection global) -----------
    match /auditoria/{logId} {
      allow read: if isDRGTeam();
      allow read: if isSignedIn() && userExists()
                  && userDoc().role == 'admin'
                  && resource.data.tenantId == userDoc().tenantId;
      allow create: if isSignedIn();
      allow update, delete: if false;  // logs são imutáveis
    }

    // ----------- INSTÂNCIAS SELF-HOSTED (Modelo C — telemetria) -----------
    // Worker grava via Firebase REST API (não passa por regras do client).
    // Aqui só liberamos LEITURA pra equipe DRG monitorar.
    match /instalacoesSelfHosted/{instalacaoId} {
      allow read: if isDRGTeam();
      allow write: if false;  // só o Worker grava (via REST)
    }
  }
}
